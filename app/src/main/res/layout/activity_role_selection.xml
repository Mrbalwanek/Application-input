<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bright_yellow"
        tools:context=".RoleSelectionActivity">

    <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt;--- NAZAD"
            android:textColor="@color/bright_red"
            android:textSize="20sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp" />

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="KIM JESTEŚ??"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/purple_primary"
            android:rotation="-2"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="50dp" />

    <Button
            android:id="@+id/btnUser"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="60dp"
            android:text="UŻYTKOWNIK 😎"
            android:textSize="22sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/bright_blue"
            android:layout_marginBottom="8dp" />

    <Button
            android:id="@+id/btnCourier"
            android:layout_width="180dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginEnd="10dp"
            android:text="kurier"
            android:textSize="12sp"
            android:textColor="@color/bright_yellow"
            android:backgroundTint="@color/bright_red" />

</LinearLayout>
